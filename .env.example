# Public base URL of the production deployment, no trailing slash. Cloud sessions call back here,
# so it must be a stable public host (a tunnel gets blocked by the session's safety check).
PUBLIC_BASE_URL=https://your-project.vercel.app

# Linear OAuth app (Settings > API > OAuth applications)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Signs per-run callback tokens and OAuth state. Any long random string.
BOT_SIGNING_SECRET=

# Vercel sets this for cron requests (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Optional admin fallback: per-user routine credentials keyed by Linear user id.
# People normally connect themselves at /connect instead.
# {"<linear-user-id>": {"fireUrl": "https://api.anthropic.com/v1/claude_code/routines/trig_.../fire", "token": "sk-ant-oat01-..."}}
ROUTINES_JSON={}

# Upstash Redis (provisioned through the Vercel Marketplace; either naming works)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Encrypts per-user routine tokens saved through /connect (any long random string)
TOKEN_ENCRYPTION_KEY=

# Where sessions work by default, and that repo's PR base branch
DEFAULT_REPOSITORY=your-org/your-repo
DEFAULT_BASE_BRANCH=main

# Same-session follow-ups: how long a finished session keeps waiting for replies (0 turns it off),
# and how long each wait call holds (keep under Claude Code's 2-minute Bash timeout)
IDLE_WINDOW_MINUTES=30
WAIT_SECONDS=100
